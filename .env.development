PORT=3000
NODE_ENV=development

# PostgreSQL Database Configuration
DB_TYPE=postgres
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=123456
DB_DATABASE=celra_db
DB_SYNCHRONIZE=true
DB_LOGGING=true

# JWT Authentication
JWT_SECRET=celra_development_jwt_secret_key_secure_2026
JWT_EXPIRES_IN=7d

# Password Reset Token
RESET_TOKEN_EXPIRES_MINUTES=15
FRONTEND_URL=http://localhost:5173
